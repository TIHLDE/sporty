# Copy to .env in the repo root. This is the only env file in the project.

# Database (matches the container in infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sporty

# Better Auth
BETTER_AUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# TIHLDE login through Photon (optional, leave empty to disable)
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=
# PHOTON_ISSUER=https://photon.tihlde.org/api/auth

# Spond account used to fetch groups and events
SPOND_EMAIL=
SPOND_PASSWORD=
# SPOND_API_URL=

# true: every Spond group is shown to everyone (for development).
# false: people only see the groups their TIHLDE user is a member of.
DISPLAY_ALL_GROUPS=false
