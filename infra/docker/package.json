{
  "name": "@sporty/docker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev:up": "docker compose up -d --wait db",
    "dev:down": "docker compose stop db",
    "dev:fresh": "docker compose down -v && docker compose up -d --wait db",
    "prod:up": "docker compose --profile app up -d --build --wait",
    "prod:down": "docker compose --profile app down"
  }
}
